library(readr)
df <- read_csv("C:\\Users\\student\\OneDrive - Bryant University\\MATH421\\GitHub\\MATH421ML\\MATH421ML\\imdb_top_1000.csv")
names(df)
library(dplyr)
df %>%
arrange(desc(Gross)) %>%
select(Series_Title, Gross)
df %>%
filter(IMDB_Rating == min(IMDB_Rating, na.rm = TRUE)) %>%
select(Series_Title, IMDB_Rating)
library(dplyr)
df %>%
group_by(Released_Year) %>%
summarise(
Number_of_Movies = n(),
Total_Gross = sum(Gross, na.rm = TRUE)
) %>%
arrange(desc(Number_of_Movies)) %>%
head(1)
library(dplyr)
df %>%
summarise(Average_Gross = mean(Gross, na.rm = TRUE))
library(dplyr)
# Part A
df %>%
group_by(Released_Year) %>%
summarise(Average_Votes = mean(No_of_Votes, na.rm = TRUE))
# Part B
df %>%
filter(IMDB_Rating > 9) %>%
summarise(Average_Votes = mean(No_of_Votes, na.rm = TRUE))
library(dplyr)
#if this question is indicating that it is above the third quartile
q3 <- quantile(df$No_of_Votes, 0.75, na.rm = TRUE)
df %>%
filter(Released_Year == 2020,No_of_Votes >= q3) %>%
summarise(Average_Meta_Score = mean(Meta_score, na.rm = TRUE))
#if this means that it is in between 50 and 75
q2 <- quantile(df$No_of_Votes, 0.50, na.rm = TRUE)
q3 <- quantile(df$No_of_Votes, 0.75, na.rm = TRUE)
df %>%
filter( Released_Year == 2020, No_of_Votes >= q2, No_of_Votes < q3) %>%
summarise(Average_Meta_Score = mean(Meta_score, na.rm = TRUE))
# Select only character columns
df %>% select_if(is.character)
# Calculate the median of all numeric columns
df %>% summarise_if(is.numeric, mean, na.rm=TRUE)
#select
df %>%
select(Series_Title,Runtime)
#filter
df %>%
filter(Meta_score == min(Meta_score, na.rm = TRUE)) %>%
select(Series_Title)
#mutate - giving rating out of 100
df %>%
mutate(Rating100 = IMDB_Rating * 10)
#summarise
df %>%
summarise(avg_rating = mean(IMDB_Rating, na.rm = TRUE))
#arrange sorting by rating
df %>%
arrange(desc(IMDB_Rating))
#count counting how many have each certificate
df %>%
count(Certificate)
#count + arrange arranging what i just counted in decreasing order of the count
df %>%
count(Certificate) %>%
arrange(desc(n))
# filter + count + arrange added a filter for the rating being higher than 8.5
df %>%
filter(IMDB_Rating > 8.5) %>%
count(Certificate) %>%
arrange(desc(n))
# group by and summarize average rating by each certificate group
df %>%
group_by(Certificate) %>%
summarise(avg_rating = mean(IMDB_Rating, na.rm = TRUE))
# filter group by summazire - added filter for no of votes to be greater than 100000
df %>%
filter(No_of_Votes > 100000) %>%
group_by(Certificate) %>%
summarise(avg_rating = mean(IMDB_Rating, na.rm = TRUE))
# filter + group_by + summarise + arrange - average meta score when the imdb rating it greater than 8.5.grouped by certificate and then organized into decreasing order
df %>%
filter(IMDB_Rating > 8.5) %>%
group_by(Certificate) %>%
summarise(avg_meta = mean(Meta_score, na.rm = TRUE)) %>%
arrange(desc(avg_meta))
