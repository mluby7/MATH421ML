library(readr)
df <- read_csv('https://bryantstats.github.io/math421/data/adult_census_missing.csv')
colSums(is.na(df))
df <- replace(df, df == 'Unknown' |
df == 'Missing' |
df == 'Not Available', NA)
colSums(is.na(df))
df1 <- drop_na(df)
df2 %>% fill(age,workclass,education,martial.status,occupation,relationship,sex,capital.gain,native.country, .direction = 'updown')
library(tidyr)
df2 %>% fill(age,workclass,education,martial.status,occupation,relationship,sex,capital.gain,native.country, .direction = 'updown')
library(tidyr)
df2 <- df %>% fill(age,workclass,education,martial.status,occupation,relationship,sex,capital.gain,native.country, .direction = 'updown')
library(tidyr)
df2 <- fill(
df,
age,
workclass,
education,
marital.status,
occupation,
relationship,
sex,
capital.gain,
native.country,
.direction = "downup"
)
View(df)
library(tidyr)
df1 <- drop_na(df)
library(tidyr)
df3 <- df
# Numeric variables -> median
df3$age <- replace_na(df3$age, median(df3$age, na.rm = TRUE))
df3$fnlwgt <- replace_na(df3$fnlwgt, median(df3$fnlwgt, na.rm = TRUE))
df3$education.num <- replace_na(df3$education.num, median(df3$education.num, na.rm = TRUE))
df3$capital.gain <- replace_na(df3$capital.gain, median(df3$capital.gain, na.rm = TRUE))
df3$capital.loss <- replace_na(df3$capital.loss, median(df3$capital.loss, na.rm = TRUE))
df3$hours.per.week <- replace_na(df3$hours.per.week, median(df3$hours.per.week, na.rm = TRUE))
# Categorical variables -> majority
majority_workclass <- names(which.max(table(df3$workclass)))
df3$workclass <- replace_na(df3$workclass, majority_workclass)
majority_education <- names(which.max(table(df3$education)))
df3$education <- replace_na(df3$education, majority_education)
majority_marital.status <- names(which.max(table(df3$marital.status)))
df3$marital.status <- replace_na(df3$marital.status, majority_marital.status)
majority_occupation <- names(which.max(table(df3$occupation)))
df3$occupation <- replace_na(df3$occupation, majority_occupation)
majority_relationship <- names(which.max(table(df3$relationship)))
df3$relationship <- replace_na(df3$relationship, majority_relationship)
majority_race <- names(which.max(table(df3$race)))
df3$race <- replace_na(df3$race, majority_race)
majority_sex <- names(which.max(table(df3$sex)))
df3$sex <- replace_na(df3$sex, majority_sex)
majority_country <- names(which.max(table(df3$native.country)))
df3$native.country <- replace_na(df3$native.country, majority_country)
majority_income <- names(which.max(table(df3$income)))
df3$income <- replace_na(df3$income, majority_income)
colSums(is.na(df3))
colSums(is.na(df2))
colSums(is.na(df1))
