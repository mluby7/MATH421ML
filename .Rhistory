filter(IMDB_Rating > 9) %>%
summarise(Average_Votes = mean(No_of_Votes, na.rm = TRUE))
library(dplyr)
#if this question is indicating that it is above the third quartile
q3 <- quantile(df$No_of_Votes, 0.75, na.rm = TRUE)
df %>%
filter(Released_Year == 2020,No_of_Votes >= q3) %>%
